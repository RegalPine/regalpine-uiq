{
  "name": "uiq",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10 <11"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck && tsc -p tsconfig.tests.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:architecture": "vitest run tests/architecture",
    "test:golden": "vitest run tests/golden",
    "test:schema": "vitest run tests/schema",
    "test:contract": "vitest run tests/schema tests/unit/conformance/contract-checkers.test.ts tests/conformance/capabilities.test.ts",
    "test:baseline": "vitest run tests/unit/regression/baseline.test.ts tests/schema/regression.schema.test.ts",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "pnpm build && vitest run tests/e2e",
    "test:browser": "pnpm build && playwright test",
    "conformance": "vitest run tests/unit/conformance tests/golden/conformance-runner.test.ts tests/schema tests/conformance/capabilities.test.ts",
    "regression": "vitest run tests/unit/regression tests/integration/regression-flow.test.ts tests/schema/regression.schema.test.ts",
    "ci": "pnpm format:check && pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm exec playwright test"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.0.0",
    "@uiq/core": "workspace:*",
    "@uiq/color": "workspace:*",
    "@uiq/geometry": "workspace:*",
    "@uiq/measurement": "workspace:*",
    "@uiq/metrics": "workspace:*",
    "@uiq/rules": "workspace:*",
    "@uiq/diagnostic": "workspace:*",
    "@uiq/browser": "workspace:*",
    "@uiq/tokens": "workspace:*",
    "@uiq/theme": "workspace:*",
    "@uiq/radix": "workspace:*",
    "@uiq/conformance": "workspace:*",
    "@uiq/regression": "workspace:*",
    "@uiq/reporting": "workspace:*",
    "ajv": "8.17.1",
    "eslint": "9.39.1",
    "prettier": "3.6.2",
    "tsup": "8.5.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.1",
    "vitest": "3.2.4"
  }
}
