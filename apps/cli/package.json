{
  "name": "@uiq/cli",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "schemas"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "uiq": "./dist/index.js"
  },
  "dependencies": {
    "@playwright/test": "1.63.0",
